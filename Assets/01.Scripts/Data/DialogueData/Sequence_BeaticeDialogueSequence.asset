  m_Name: Sequence_BeaticeDialogueSequence
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceData
  _sourceText: {fileID: 4900000, guid: 146729efc75d48948b515a09089980ce, type: 3}
  _lines:
  - "\u2026\uC654\uAD6C\uB098."
  - "\uCC98\uC74C\uC774\uC9C0? \uC800 \uC544\uC774\uB4E4 \uBCF4\uB294 \uAC8C.\r\n\uC791\uC544
    \uBCF4\uC774\uC9C0? \uB9DE\uC544, \uC791\uC544."
  - "\uC544\uC9C1 \uBB58 \uBA39\uC5B4\uC57C \uD558\uB294\uC9C0\uB3C4, \uB204\uAD74
    \uBBFF\uC5B4\uC57C \uD558\uB294\uC9C0\uB3C4 \uBAB0\uB77C.\r\n\uADF8\uB798\uC11C
    \uB098\uB294 \uCC98\uBC8C\uBCF4\uB2E4 \uBA3C\uC800 \uC190\uC744 \uB0B4\uBC00\uACE0
    \uC2F6\uC5B4."
  - "\uB118\uC5B4\uC9C4 \uC544\uC774\uD55C\uD14C \uC77C\uC5B4\uB098\uB77C\uACE0 \uD558\uAE30
    \uC804\uC5D0, \r\n\uC77C\uB2E8 \uC7A1\uC544\uC918\uC57C \uD558\uC796\uC544."
  - "\uC544\uBB34\uB3C4 \uD63C\uC790 \uB450\uC9C0 \uC54A\uB294 \uAC83.\r\n\uADF8\uAC8C
    \uB0B4\uAC00 \uC800 \uC544\uC774\uB4E4\uD55C\uD14C \uC904 \uC218 \uC788\uB294
    \uCCAB \uBC88\uC9F8 \uC77C\uC774\uC57C."
