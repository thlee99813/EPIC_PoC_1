  m_Script: {fileID: 11500000, guid: fd7b83552739eaf4b9dac925d05b4c60, type: 3}
  m_Name: Sequence_ReticaDialogueSequence
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceData
  _sourceText: {fileID: 4900000, guid: 37b91613a63878545bc0fd9e5117d08f, type: 3}
  _lines:
  - "\uB3D9\uC815\uC740 \uD544\uC694 \uC5C6\uC5B4."
  - "\uCC98\uC74C \uC138\uC6B4 \uC120\uC774 \uC624\uB798 \uAC04\uB2E4.\r\n\uD750\uB9BF\uD55C
    \uAE08\uAE30\uB294 \uACB0\uAD6D \uAE08\uAE30\uAC00 \uC544\uB2C8\uAC8C \uB418\uC9C0."
  - "\uC800\uB4E4\uC740 \uC9C0\uAE08 \uBC30\uC6CC\uC57C \uD574.\r\n\uB2FF\uC544\uB3C4
    \uB418\uB294 \uAC83\uACFC, \uB118\uC5B4\uC11C\uBA74 \uC548 \uB418\uB294 \uAC83\uC744."
  - "\uC790\uBE44\uB294 \uC9C8\uC11C \uC704\uC5D0 \uC788\uC744 \uB54C\uB9CC \uC790\uBE44\uC57C.\r\n\uADF8
    \uC544\uB798\uC5D0 \uC544\uBB34\uAC83\uB3C4 \uC5C6\uB2E4\uBA74, \uADF8\uAC74
    \uBC29\uCE58\uB2E4."
  - "\uC800\uB4E4\uC740 \uC9C0\uAE08 \uC544\uBB34\uAC83\uB3C4 \uBAA8\uB974\uB294
    \uC0C1\uD0DC\uC57C.\r\n\uADF8\uAC8C \uC704\uD5D8\uD55C \uAC70\uC57C \uBAA8\uB978\uB2E4\uB294
    \uAC8C."
  - "\uCC98\uC74C\uBD80\uD130 \uC120\uC744 \uADF8\uC5B4\uC57C \uD574.\r\n\uC790\uBE44\uB294
    \uADF8 \uB2E4\uC74C \uC598\uAE30\uC57C."
