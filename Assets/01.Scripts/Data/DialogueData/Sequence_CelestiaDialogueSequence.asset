  m_Script: {fileID: 11500000, guid: fd7b83552739eaf4b9dac925d05b4c60, type: 3}
  m_Name: Sequence_CelestiaDialogueSequence
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceData
  _sourceText: {fileID: 4900000, guid: 33aeeba3963aa6f4abc124fb47a2c1dd, type: 3}
  _lines:
  - "\uBC8C\uC368 \uC815\uD558\uB824\uACE0? \uADC0\uC5FD\uB124."
  - "\uC800 \uC544\uC774\uB4E4, \uC9C0\uAE08 \uBB58 \uD574\uC57C \uD560\uC9C0 \uD558\uB098\uB3C4
    \uBAA8\uB97C\uAC70\uC544.\r\n\uAC81\uBA39\uACE0, \uBE7C\uC557\uACE0, \uB3C4\uB9DD\uCE58\uACE0."
  - "\uADFC\uB370 \uC788\uC796\uC544. \uADF8\uAC8C \uAF2D \uB098\uC05C \uAC74 \uC544\uB2C8\uC57C.\r\n\uD63C\uB780
    \uC18D\uC5D0\uC11C\uB9CC \uC790\uB77C\uB294 \uADDC\uCE59\uB3C4 \uC788\uAC70\uB4E0."
  - "\uB0B4\uAC00 \uB2F5\uC744 \uC2EC\uC5B4\uC8FC\uBA74 \uB108\uBB34 \uBE68\uB9AC
    \uAD73\uC5B4\uBC84\uB824.\r\n\uD754\uB4E4\uB9AC\uAC8C \uD574. \uB118\uC5B4\uC9C0\uAC8C
    \uD574."
  - "\uC790\uAE30 \uAC83\uC740,\r\n\uC790\uAE30\uAC00 \uC9C0\uD0A4\uB294 \uC790\uB9CC
    \uAC00\uC9C8 \uC218 \uC788\uB2E4."
  - "\uB2E8\uC21C\uD558\uC9C0?\r\n\uADF8\uB798\uC57C \uC624\uB798 \uB0A8\uC544.\r\n"
