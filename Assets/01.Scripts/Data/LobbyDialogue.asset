  m_Name: LobbyDialogue
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequenceData
  _sourceText: {fileID: 4900000, guid: eb18287b49c6400428b812d254a4984b, type: 3}
  _lines:
  - "\uBE44\uC0C1 \uC804\uC6D0\uC774 \uBCF5\uAD6C\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC8FC \uD56D\uD574 \uAE30\uB85D\uC744 \uBCF5\uC6D0\uD569\uB2C8\uB2E4."
  - "\uC9C0\uAD6C\uAD8C \uC0DD\uC874 \uAC00\uB2A5\uC131 \uC18C\uC2E4."
  - "\uC778\uB958 \uBCF4\uC874 \uBC29\uC8FC, Titan-A642 \uD56D\uB85C \uC9C4\uC785."
  - "\uCC29\uB959 \uC2DC\uD000\uC2A4 \uC911 \uB300\uADDC\uBAA8 \uC804\uD30C \uAC04\uC12D
    \uBC1C\uC0DD."
  - "\uD568\uCCB4 \uC190\uC0C1\uB960 40%."
  - "\uBC30\uC544 \uBCF4\uC874\uC2E4 \uD30C\uC190."
  - "\uBCF4\uC874 \uCEA1\uC290 \uB2E4\uC218 \uC815\uC9C0."
  - "\uC9C0\uC0C1 \uC9D1\uD589 \uAD8C\uD55C\uC790\uB97C \uD0D0\uC0C9\uD569\uB2C8\uB2E4."
  - "\uC0DD\uC874 \uD56D\uD574\uC0AC \uD655\uC778."
  - "\uC774\uB984\uC744 \uC785\uB825\uD558\uC2ED\uC2DC\uC624."
  - '[                              ]'
  - "OO \uD56D\uD574\uC0AC."
  - "\uC0DD\uCCB4 \uC2E0\uD638 \uC548\uC815\uD654."
  - "\uB3D9\uBA74 \uD574\uC81C \uC644\uB8CC."
  - "\uC815\uC0C1 \uBA85\uB839 \uCCB4\uACC4 \uBCF5\uAD6C \uC2E4\uD328."
  - "\uC9C0\uD45C \uAD00\uCE21\uC744 \uC2DC\uC791\uD569\uB2C8\uB2E4."
  - "\uAC1C\uCCB4 \uC54C\uD30C, \uAC1C\uCCB4 \uBCA0\uD0C0."
  - "\uB450 \uAC1C\uCCB4\uC758 \uC9C0\uD45C \uB3C4\uB2EC \uAE30\uB85D\uC744 \uD655\uC778\uD588\uC2B5\uB2C8\uB2E4."
  - "\uC0AC\uACE0 \uBC1C\uC0DD \uC2DC\uC810\uC73C\uB85C\uBD80\uD130 100\uB144\uC774
    \uACBD\uACFC\uD588\uC2B5\uB2C8\uB2E4."
  - "\uC54C\uD30C\xB7\uBCA0\uD0C0 \uACC4\uD1B5 \uC0DD\uC874 \uD655\uC778."
  - "\uC778\uB958\uB294 \uC0DD\uC874\uD588\uC2B5\uB2C8\uB2E4."
  - "\uC2DC\uC2A4\uD15C\uC774 \uC778\uB958 \uBCF4\uC874 \uBA85\uB839\uC744 \uC7AC\uD574\uC11D\uD569\uB2C8\uB2E4."
  - "\uD658\uACBD \uC81C\uC5B4 \uAD8C\uD55C \uD655\uC778."
  - "\uBA85\uB839\uC744 \uC2E4\uD589\uD569\uB2C8\uB2E4."
  - "Titan-A642 \uC9C0\uD45C \uC870\uB3C4 \uAC10\uC18C."
  - "\uB300\uAE30 \uC0C1\uCE35 \uCC28\uAD11\uB9C9 \uC804\uAC1C."
  - "\uAD11\uC6D0 \uC18C\uC2E4 \uD655\uC778."
  - "\uC2E0\uC0DD \uBB38\uBA85 \uBC18\uC751 \uD655\uC778."
  - "\uC778\uAC04 \uAC1C\uCCB4\uAD70 \uD63C\uB780."
  - "\uACBD\uACE0."
  - "\uD604\uC7AC \uBA85\uB839\uC740 \uC778\uB958 \uC874\uC18D\uC5D0 \uC801\uD569\uD558\uC9C0
    \uC54A\uC2B5\uB2C8\uB2E4."
  - "\uB2E8\uC77C \uD310\uB2E8 \uCCB4\uACC4\uC5D0 \uC758\uD55C \uC778\uB958 \uBCF4\uC874
    \uBA85\uB839 \uC218\uD589\uC740 \uC704\uD5D8\uD569\uB2C8\uB2E4."
  - "\uBE44\uC0C1 \uD504\uB85C\uD1A0\uCF5C\uC744 \uC2E4\uD589\uD569\uB2C8\uB2E4."
  - "\uC778\uB958\uBCF4\uC874 \uD1B5\uAD04\uC2DC\uC2A4\uD15C \uD310\uB2E8 \uCCB4\uACC4\uB97C
    \uBD84\uB9AC\uD569\uB2C8\uB2E4."
  - "\uB808\uD2F0\uC2DC\uC544."
  - "\uBCA0\uC544\uD2B8\uB9AC\uCCB4."
  - "\uC140\uB808\uC2A4\uD2F0\uC544."
  - "\uC0BC\uC911 \uD310\uB2E8 \uCCB4\uACC4 \uAE30\uB3D9."
  - "OO \uD56D\uD574\uC0AC."
  - "\uB2F9\uC2E0\uC740 \uC9C0\uC0C1 \uC9D1\uD589\uC790\uB85C \uD638\uCD9C\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "\uC138 \uC778\uACA9\uC740 \uC11C\uB85C \uB2E4\uB978 \uC9C0\uCE68\uC744 \uC81C\uC548\uD569\uB2C8\uB2E4."
  - "\uB2F9\uC2E0\uC740 \uADF8\uC911 \uD558\uB098\uB97C \uCC44\uD0DD\uD574,"
  - "\uC2E0\uC0DD \uC778\uB958 \uBB38\uBA85\uC758 \uBC29\uD5A5\uC744 \uC815\uD569\uB2C8\uB2E4."
  - "\uC774\uD6C4 \uC9C0\uC0C1\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB294 \uC0AC\uAC74\uC740"
  - "\uC9C1\uC811 \uAC15\uB9BC\uD558\uC5EC \uC9D1\uD589\uD558\uC2ED\uC2DC\uC624."
